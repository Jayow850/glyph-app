// ============================================================
// GLYPH — Global Chess Community OS
// Production Prisma Schema (PostgreSQL)
// Multi-tenant: all club-scoped data carries clubId
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------

enum Role {
  OWNER
  ADMIN
  ORGANIZER
  ARBITER
  COACH
  PLAYER
  PARENT
}

enum TimeControl {
  CLASSICAL
  RAPID
  BLITZ
  BULLET
}

enum TournamentFormat {
  SWISS
  ROUND_ROBIN
  KNOCKOUT
  TEAM_SWISS
  LADDER
  SIMUL
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  CHECK_IN
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum MatchResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  WHITE_FORFEIT
  BLACK_FORFEIT
  DOUBLE_FORFEIT
  BYE_FULL
  BYE_HALF
  PENDING
}

enum ResultStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  DISPUTED
  ARBITER_RULED
}

enum EventType {
  TOURNAMENT
  TRAINING
  MEETING
  FRIENDLY
  SIMUL
  LECTURE
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
  WAITLIST
}

enum NotificationType {
  PAIRING
  RESULT
  TOURNAMENT_UPDATE
  CLUB_ANNOUNCEMENT
  MESSAGE
  ACHIEVEMENT
  RATING_CHANGE
  EVENT_REMINDER
  DISPUTE
  SYSTEM
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum ChessTitle {
  GM
  IM
  FM
  CM
  WGM
  WIM
  WFM
  WCM
  NM
  NONE
}

enum PrivacyLevel {
  PUBLIC
  CLUB_ONLY
  PRIVATE
}

enum PostType {
  TEXT
  PHOTO
  VIDEO
  GAME
  PUZZLE
  CLIP
  LIVE
}

enum ReactionKind {
  PAWN
  BRILLIANT
  FIRE
  SHOCK
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
}

enum LiveGameStatus {
  ACTIVE
  FINISHED
  ABORTED
}

// ---------------- IDENTITY ----------------

model User {
  glyphRatings GlyphRating[] @relation("GlyphRatings")
  gameMessages GameMessage[] @relation("GameMessages")
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  oauthProvider  String?
  oauthId        String?
  emailVerified  Boolean  @default(false)
  isMinor        Boolean  @default(false)
  parentId       String?
  parent         User?    @relation("ParentChild", fields: [parentId], references: [id])
  children       User[]   @relation("ParentChild")
  locale         String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bannedAt       DateTime?
  banReason      String?

  profile        Profile?
  memberships    Membership[]
  ratings        Rating[]
  tournamentEntries TournamentPlayer[]
  whiteMatches   Match[]  @relation("WhitePlayer")
  blackMatches   Match[]  @relation("BlackPlayer")
  messages       Message[]
  chatMembers    ChatRoomMember[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  rsvps          Rsvp[]
  notifications  Notification[]
  achievements   UserAchievement[]
  followers      Follow[] @relation("Following")
  following      Follow[] @relation("Follower")
  games          Game[]   @relation("GameOwner")
  challengesSent     Challenge[] @relation("ChallengesSent")
  challengesReceived Challenge[] @relation("ChallengesReceived")
  liveGamesWhite     LiveGame[]  @relation("LiveGamesWhite")
  liveGamesBlack     LiveGame[]  @relation("LiveGamesBlack")
  auditLogs      AuditLog[]
  disputesRaised Dispute[] @relation("DisputeRaiser")
  disputesRuled  Dispute[] @relation("DisputeArbiter")
  bookmarks      Bookmark[]
  bookmarkFolders BookmarkFolder[]
  streak         Streak?
  clubJoinRequests ClubJoinRequest[]

  @@index([email])
}

model Profile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  handle        String       @unique
  avatarUrl     String?
  bannerUrl     String?
  country       String?
  bio           String?      @db.Text
  birthYear     Int?
  gender        String?
  genderPrivacy PrivacyLevel @default(PRIVATE)
  agePrivacy    PrivacyLevel @default(PRIVATE)
  title         ChessTitle   @default(NONE)
  fideId        String?
  nationalId    String?
  verified      Boolean      @default(false)
  favoriteOpening String?
  boardTheme    String       @default("midnight")
  pieceSet      String       @default("classic")
  lastSeenAt    DateTime?
  updatedAt     DateTime     @updatedAt

  @@index([handle])
  @@index([country])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// ---------------- RATINGS ----------------

model Rating {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId      String?
  club        Club?       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  timeControl TimeControl
  current     Int         @default(1200)
  peak        Int         @default(1200)
  gamesPlayed Int         @default(0)
  provisional Boolean     @default(true)
  verified    Boolean     @default(false)
  verifySource String?
  kFactor     Int         @default(40)
  updatedAt   DateTime    @updatedAt

  history     RatingHistory[]

  @@unique([userId, clubId, timeControl])
  @@index([clubId, timeControl, current])
}

model RatingHistory {
  id           String   @id @default(cuid())
  gameId       String?
  ratingId     String
  rating       Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  matchId      String?
  tournamentId String?
  before       Int
  after        Int
  delta        Int
  createdAt    DateTime @default(now())

  @@index([ratingId, createdAt])
}

// ---------------- CLUBS ----------------

model Club {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  logoUrl      String?
  bannerUrl    String?
  description  String?  @db.Text
  country      String?
  city         String?
  isScholastic Boolean  @default(false)
  isPublic     Boolean  @default(true)
  inviteCode   String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  tournaments  Tournament[]
  ratings      Rating[]
  posts        Post[]
  events       Event[]
  chatRooms    ChatRoom[]
  seasons      Season[]
  subscription Subscription?
  achievements Achievement[]
  joinRequests ClubJoinRequest[]

  @@index([slug])
  @@index([country, city])
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role     Role     @default(PLAYER)
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)

  @@unique([userId, clubId])
  @@index([clubId, role])
}

model Season {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  tournaments Tournament[]
}

// ---------------- TOURNAMENTS ----------------

model Tournament {
  id            String           @id @default(cuid())
  clubId        String
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId      String?
  season        Season?          @relation(fields: [seasonId], references: [id])
  name          String
  format        TournamentFormat @default(SWISS)
  timeControl   TimeControl      @default(RAPID)
  timeControlDetail String?
  status        TournamentStatus @default(DRAFT)
  totalRounds   Int              @default(5)
  currentRound  Int              @default(0)
  isRated       Boolean          @default(true)
  kFactorOverride Int?
  maxPlayers    Int?
  entryFeeCents Int?             @default(0)
  startsAt      DateTime?
  checkInOpensAt DateTime?
  location      String?
  description   String?          @db.Text
  tiebreakOrder String[]         @default(["BUCHHOLZ", "SONNEBORN_BERGER", "DIRECT_ENCOUNTER"])
  allowHalfByes Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  entries TournamentPlayer[]
  rounds  Round[]
  chatRoom ChatRoom?

  @@index([clubId, status])
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedRating   Int        @default(1200)
  score        Float      @default(0)
  checkedIn    Boolean    @default(false)
  withdrawn    Boolean    @default(false)
  withdrawnAtRound Int?
  requestedByes Int[]     @default([])
  colorHistory String     @default("")
  performanceRating Int?
  finalRank    Int?

  @@unique([tournamentId, userId])
  @@index([tournamentId, score])
}

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  startsAt     DateTime?
  completedAt  DateTime?
  matches      Match[]

  @@unique([tournamentId, number])
}

model Match {
  id           String       @id @default(cuid())
  roundId      String
  round        Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  boardNumber  Int
  whiteId      String?
  blackId      String?
  white        User?        @relation("WhitePlayer", fields: [whiteId], references: [id])
  black        User?        @relation("BlackPlayer", fields: [blackId], references: [id])
  result       MatchResult  @default(PENDING)
  resultStatus ResultStatus @default(PENDING)
  submittedById String?
  clientTimestamp DateTime?
  confirmedAt  DateTime?
  liveGameId   String?      @unique
  liveGame     LiveGame?    @relation(fields: [liveGameId], references: [id])
  game         Game?
  dispute      Dispute?

  @@index([roundId])
  @@index([whiteId])
  @@index([blackId])
}

// PGN archive of finished games

model Game {
  id        String   @id @default(cuid())
  matchId   String?  @unique
  match     Match?   @relation(fields: [matchId], references: [id])
  ownerId   String
  owner     User     @relation("GameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pgn       String   @db.Text
  eco       String?
  moveCount Int?
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([eco])
}

model Dispute {
  id         String   @id @default(cuid())
  matchId    String   @unique
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedById String
  raisedBy   User     @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason     String   @db.Text
  ruling     String?  @db.Text
  arbiterId  String?
  arbiter    User?    @relation("DisputeArbiter", fields: [arbiterId], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
}

// ---------------- LIVE PLAY (human vs human) ----------------

/** A challenge from one player to another. Accepting creates a LiveGame. */
model Challenge {
  id          String   @id @default(cuid())
  fromId      String
  from        User     @relation("ChallengesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String?  // null = an open seek any club member may accept
  to          User?    @relation("ChallengesReceived", fields: [toId], references: [id], onDelete: Cascade)
  clubId      String?
  expiresAt   DateTime?
  timeControl String   @default("900+10")
  color       String   @default("random")
  rated       Boolean  @default(true)
  status      String   @default("pending")
  liveGameId  String?
  message     String?
  createdAt   DateTime @default(now())

  @@index([toId, status])
}

/** A game two humans are actually playing. The server owns the position. */
model LiveGame {
  id          String         @id @default(cuid())
  whiteId     String
  white       User           @relation("LiveGamesWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId     String
  black       User           @relation("LiveGamesBlack", fields: [blackId], references: [id], onDelete: Cascade)
  fen         String         @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  sans        String[]       @default([])
  status      LiveGameStatus @default(ACTIVE)
  result      String?
  endReason   String?
  timeControl String         @default("900+10")
  rated       Boolean        @default(true)
  whiteMs     Int            @default(900000)
  blackMs     Int            @default(900000)
  incrementMs Int            @default(10000)
  lastMoveAt  DateTime       @default(now())
  drawOfferBy String?
  category    SpeedCategory  @default(RAPID)
  clockStarted Boolean       @default(false)
  whiteRatingBefore Int?
  blackRatingBefore Int?
  whiteRatingDelta  Int?
  blackRatingDelta  Int?
  undoFen      String?
  undoWhiteMs  Int?
  undoBlackMs  Int?
  takebackBy   String?
  disconnectAt DateTime?
  messages    GameMessage[]
  match       Match?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
}

// ---------------- MESSAGING ----------------

model ChatRoom {
  id           String   @id @default(cuid())
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tournamentId String?  @unique
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  name         String?
  isDirect     Boolean  @default(false)
  isRequest    Boolean  @default(false)
  acceptedAt   DateTime?
  isAnnouncement Boolean @default(false)
  category     String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  members  ChatRoomMember[]
  messages Message[]

  @@index([clubId])
}

model ChatRoomMember {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())
  muted      Boolean  @default(false)

  @@unique([roomId, userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  fileUrl   String?
  fileType  String?
  replyToId String?
  reactions Reaction[]
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([roomId, createdAt])
}

// ---------------- FEED ----------------

model Post {
  id        String   @id @default(cuid())
  clubId    String?
  authorId  String
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      PostType @default(TEXT)
  body      String?  @db.Text

  mediaUrls   String[] @default([])
  videoUrl    String?
  durationSec Int?
  isStudio    Boolean  @default(false)

  pgn            String? @db.Text
  criticalPly    Int?

  puzzleFen      String?
  puzzleSolution String?
  solveCount     Int      @default(0)
  attemptCount   Int      @default(0)

  pinned     Boolean  @default(false)
  pinnedAt   DateTime?
  archived   Boolean  @default(false)
  archivedAt DateTime?
  visibility PostVisibility @default(PUBLIC)
  editedAt   DateTime?
  viewCount  Int      @default(0)
  shareCount Int      @default(0)
  saveCount  Int      @default(0)
  repostCount Int     @default(0)
  repostOfId String?
  repostOf   Post?    @relation("Reposts", fields: [repostOfId], references: [id])
  reposts    Post[]   @relation("Reposts")
  hdOriginalUrl String?
  comments  Comment[]
  reactions Reaction[]
  bookmarks Bookmark[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, pinned, createdAt])
  @@index([authorId, createdAt])
  @@index([type, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String?  @db.Text
  videoUrl  String?
  parentId  String?
  parent    Comment? @relation("Thread", fields: [parentId], references: [id])
  replies   Comment[] @relation("Thread")
  reactions Reaction[]
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([parentId])
}

model Reaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ReactionKind @default(PAWN)
  reactorElo   Int?
  postId       String?
  commentId    String?
  messageId    String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, kind, postId, commentId, messageId])
  @@index([postId, kind])
}

// ---------------- EVENTS ----------------

model Event {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        EventType @default(MEETING)
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  reminderSent Boolean  @default(false)
  rsvps       Rsvp[]
  createdAt   DateTime  @default(now())

  @@index([clubId, startsAt])
}

model Rsvp {
  id       String     @id @default(cuid())
  eventId  String
  userId   String
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   RsvpStatus @default(GOING)
  attended Boolean?

  @@unique([eventId, userId])
}

// ---------------- ACHIEVEMENTS ----------------

model Achievement {
  id          String  @id @default(cuid())
  clubId      String?
  club        Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String
  iconUrl     String?
  awards      UserAchievement[]

  @@unique([clubId, code])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  tournamentId  String?
  awardedAt     DateTime    @default(now())

  @@index([userId])
}

// ---------------- NOTIFICATIONS ----------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// ---------------- BILLING ----------------

model Subscription {
  id                   String             @id @default(cuid())
  clubId               String             @unique
  club                 Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Payment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?      @unique
  amountCents     Int
  currency        String       @default("usd")
  paidAt          DateTime?
  invoiceUrl      String?
  createdAt       DateTime     @default(now())
}

// ---------------- SOCIAL EXTRAS ----------------

model ClubJoinRequest {
  id        String            @id @default(cuid())
  clubId    String
  userId    String
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  decidedBy String?
  createdAt DateTime          @default(now())

  @@unique([clubId, userId])
  @@index([clubId, status])
}

model BookmarkFolder {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())

  @@unique([userId, name])
}

model Bookmark {
  id        String          @id @default(cuid())
  userId    String
  postId    String
  folderId  String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  folder    BookmarkFolder? @relation(fields: [folderId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([userId, postId])
}

model Streak {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current      Int       @default(0)
  best         Int       @default(0)
  freezes      Int       @default(1)
  lastActiveAt DateTime?
}

// ---------------- AUDIT ----------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  clubId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}
// ---------------- GLYPH RATINGS & GAME CHAT ----------------

enum SpeedCategory {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum GameMessageKind {
  CHAT
  QUICK
  SYSTEM
}

/**
 * Platform-wide rating, one row per speed. Glicko-1: the number is only
 * half the story, `rd` is how sure we are of it. Provisional while
 * rd > 110, which is how a new player stops swinging after ~15 games.
 */
model GlyphRating {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation("GlyphRatings", fields: [userId], references: [id], onDelete: Cascade)
  category     SpeedCategory
  rating       Float         @default(1200)
  rd           Float         @default(350)
  games        Int           @default(0)
  peak         Int           @default(1200)
  volatility   Float         @default(0.06)
  wins         Int           @default(0)
  losses       Int           @default(0)
  draws        Int           @default(0)
  peakAt       DateTime?
  lastPlayedAt DateTime?
  history      GlyphRatingHistory[]

  @@unique([userId, category])
  @@index([category, rating])
}

model GameMessage {
  id        String          @id @default(cuid())
  gameId    String
  game      LiveGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("GameMessages", fields: [userId], references: [id], onDelete: Cascade)
  body      String
  kind      GameMessageKind @default(CHAT)
  createdAt DateTime        @default(now())

  @@index([gameId, createdAt])
}

/**
 * One row per rated game, per player. This is what a profile graph is
 * drawn from, and what makes a rating auditable rather than a number
 * that simply changed overnight.
 */
model GlyphRatingHistory {
  id             String      @id @default(cuid())
  glyphRatingId  String
  glyphRating    GlyphRating @relation(fields: [glyphRatingId], references: [id], onDelete: Cascade)
  liveGameId     String?
  before         Int
  after          Int
  delta          Int
  opponentRating Int
  result         String      // win | loss | draw
  createdAt      DateTime    @default(now())

  @@index([glyphRatingId, createdAt])
}
