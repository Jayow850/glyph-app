// ============================================================
// GLYPH — Global Chess Community OS
// Production Prisma Schema (PostgreSQL)
// Multi-tenant: all club-scoped data carries clubId
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- ENUMS ----------------

enum Role {
  OWNER
  /// Real clubs are run by officers, not admins. Added, never renamed:
  /// every existing membership keeps the role it already has.
  PRESIDENT
  /// Directs the club championship.
  VICE_PRESIDENT
  /// Maintains the league tables.
  COMPETITION_SECRETARY
  SECRETARY
  TREASURER
  ADMIN
  ORGANIZER
  ARBITER
  COACH
  PLAYER
  PARENT
}

enum TimeControl {
  CLASSICAL
  RAPID
  BLITZ
  BULLET
}

enum TournamentFormat {
  SWISS
  ROUND_ROBIN
  KNOCKOUT
  TEAM_SWISS
  LADDER
  SIMUL
}

enum TournamentStatus {
  DRAFT
  REGISTRATION
  CHECK_IN
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum MatchResult {
  WHITE_WIN
  BLACK_WIN
  DRAW
  WHITE_FORFEIT
  BLACK_FORFEIT
  DOUBLE_FORFEIT
  BYE_FULL
  BYE_HALF
  PENDING
}

enum ResultStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  DISPUTED
  ARBITER_RULED
}

enum EventType {
  TOURNAMENT
  TRAINING
  MEETING
  FRIENDLY
  SIMUL
  LECTURE
}

enum RsvpStatus {
  GOING
  MAYBE
  NOT_GOING
  WAITLIST
}

enum NotificationType {
  PAIRING
  RESULT
  TOURNAMENT_UPDATE
  CLUB_ANNOUNCEMENT
  MESSAGE
  ACHIEVEMENT
  RATING_CHANGE
  EVENT_REMINDER
  DISPUTE
  SYSTEM
}

enum SubscriptionTier {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum ChessTitle {
  GM
  IM
  FM
  CM
  WGM
  WIM
  WFM
  WCM
  NM
  NONE
}

enum PrivacyLevel {
  PUBLIC
  CLUB_ONLY
  PRIVATE
}

enum PostType {
  TEXT
  PHOTO
  VIDEO
  GAME
  PUZZLE
  CLIP
  LIVE
  POSITION
  MILESTONE
  BRILLIANCY
  /** "X joined the club" — a real post, so it takes replies and welcomes. */
  WELCOME
}

enum ReactionKind {
  PAWN
  BRILLIANT
  FIRE
  SHOCK
  /** Greeting a newcomer. Counted, because being seen to do it is
      what makes people do it again. */
  WELCOME
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
}

enum LiveGameStatus {
  ACTIVE
  FINISHED
  ABORTED
}

// ---------------- IDENTITY ----------------

model User {
  glyphRatings GlyphRating[] @relation("GlyphRatings")
  gameMessages GameMessage[] @relation("GameMessages")
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String?
  oauthProvider  String?
  oauthId        String?
  emailVerified  Boolean  @default(false)
  isMinor        Boolean  @default(false)
  parentId       String?
  parent         User?    @relation("ParentChild", fields: [parentId], references: [id])
  children       User[]   @relation("ParentChild")
  locale         String   @default("en")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  bannedAt       DateTime?
  banReason      String?

  profile        Profile?
  memberships    Membership[]
  ratings        Rating[]
  tournamentEntries TournamentPlayer[]
  whiteMatches   Match[]  @relation("WhitePlayer")
  blackMatches   Match[]  @relation("BlackPlayer")
  messages       Message[]
  chatMembers    ChatRoomMember[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  rsvps          Rsvp[]
  notifications  Notification[]
  achievements   UserAchievement[]
  followers      Follow[] @relation("Following")
  following      Follow[] @relation("Follower")
  games          Game[]   @relation("GameOwner")
  challengesSent     Challenge[] @relation("ChallengesSent")
  challengesReceived Challenge[] @relation("ChallengesReceived")
  liveGamesWhite     LiveGame[]  @relation("LiveGamesWhite")
  liveGamesBlack     LiveGame[]  @relation("LiveGamesBlack")
  auditLogs      AuditLog[]
  disputesRaised Dispute[] @relation("DisputeRaiser")
  disputesRuled  Dispute[] @relation("DisputeArbiter")
  bookmarks      Bookmark[]
  bookmarkFolders BookmarkFolder[]
  streak         Streak?
  clubJoinRequests ClubJoinRequest[]
  spectating     Spectator[]
  railReactions  RailReaction[]
  whispers       Whisper[]
  clubNightRsvps ClubNightRsvp[]
  ladderRungs    LadderRung[]
  reportsRaised  Report[] @relation("ReportsRaised")
  blocksMade     Block[]  @relation("BlocksMade")
  blocksAgainst  Block[]  @relation("BlocksAgainst")
  seasonsWon         Season[]          @relation("SeasonChampion")
  divisionMemberships DivisionMember[]
  fixturesWhite      LeagueFixture[]   @relation("FixtureWhite")
  fixturesBlack      LeagueFixture[]   @relation("FixtureBlack")
  laddersChallenged  LadderChallenge[] @relation("LadderChallenger")
  laddersDefended    LadderChallenge[] @relation("LadderDefender")
  trophyAwards       TrophyAward[]

  @@index([email])
}

model Profile {
  id            String       @id @default(cuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName      String
  handle        String       @unique
  avatarUrl     String?
  bannerUrl     String?
  country       String?
  bio           String?      @db.Text
  birthYear     Int?
  gender        String?
  genderPrivacy PrivacyLevel @default(PRIVATE)
  agePrivacy    PrivacyLevel @default(PRIVATE)
  title         ChessTitle   @default(NONE)
  fideId        String?
  nationalId    String?
  verified      Boolean      @default(false)
  favoriteOpening String?
  boardTheme    String       @default("midnight")
  pieceSet      String       @default("classic")
  lastSeenAt    DateTime?
  /** Hide the rail's reactions while you are playing. */
  railMuted     Boolean      @default(false)
  /** Games walked out of. Clubs need this; serial abandoners ruin club play. */
  abandons      Int          @default(0)
  updatedAt     DateTime     @updatedAt

  @@index([handle])
  @@index([country])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
}

// ---------------- RATINGS ----------------

model Rating {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId      String?
  club        Club?       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  timeControl TimeControl
  current     Int         @default(1200)
  peak        Int         @default(1200)
  gamesPlayed Int         @default(0)
  provisional Boolean     @default(true)
  verified    Boolean     @default(false)
  verifySource String?
  kFactor     Int         @default(40)
  updatedAt   DateTime    @updatedAt

  history     RatingHistory[]

  @@unique([userId, clubId, timeControl])
  @@index([clubId, timeControl, current])
}

model RatingHistory {
  id           String   @id @default(cuid())
  gameId       String?
  ratingId     String
  rating       Rating   @relation(fields: [ratingId], references: [id], onDelete: Cascade)
  matchId      String?
  tournamentId String?
  before       Int
  after        Int
  delta        Int
  createdAt    DateTime @default(now())

  @@index([ratingId, createdAt])
}

// ---------------- CLUBS ----------------

model Club {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  logoUrl      String?
  bannerUrl    String?
  description  String?  @db.Text
  country      String?
  city         String?
  isScholastic Boolean  @default(false)
  isPublic     Boolean  @default(true)
  inviteCode   String?  @unique
  /**
   * IANA zone, e.g. "Europe/London".
   *
   * The weekly club-night rollover runs in this, not in milliseconds.
   * Adding 7x24h is exact in Nairobi and wrong twice a year in London.
   */
  timezone     String   @default("UTC")

  /// --- Ladder rules. Four numbers a secretary can tune, because the
  /// documented reason club ladders die is rule complexity.
  /** You may challenge at most this many rungs above you. */
  ladderRange        Int @default(3)
  /** Days before the same pair may meet again on the ladder. */
  ladderCooldownDays Int @default(14)
  /** Nobody may be challenged more than this in a rolling week. */
  ladderMaxPerWeek   Int @default(2)
  /** Decline more than this in a row and the next is auto-accepted. */
  ladderMaxDeclines  Int @default(2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  tournaments  Tournament[]
  clubNights   ClubNight[]
  ladder       LadderRung[]
  ladderChallenges LadderChallenge[]
  trophies     Trophy[]
  gradingSubmissions GradingSubmission[]
  homeMatches  TeamMatch[] @relation("TeamMatchHome")
  awayMatches  TeamMatch[] @relation("TeamMatchAway")
  ratings      Rating[]
  posts        Post[]
  events       Event[]
  chatRooms    ChatRoom[]
  seasons      Season[]
  subscription Subscription?
  achievements Achievement[]
  joinRequests ClubJoinRequest[]

  @@index([slug])
  @@index([country, city])
}

model Membership {
  id       String   @id @default(cuid())
  userId   String
  clubId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role     Role     @default(PLAYER)
  joinedAt DateTime @default(now())
  active   Boolean  @default(true)
  /** Who is looking after this member for their first week. */
  hostFor    String?
  /** Set when the first welcome lands, so nobody is welcomed twice. */
  welcomedAt DateTime?
  /** When this role was taken up. Service to a club should be visible. */
  roleSince  DateTime?

  @@unique([userId, clubId])
  @@index([clubId, role])
}

/// A club's year: roughly September to May, closing at an AGM.
///
/// Clubs do not run events, they run a season with an arc and a
/// champion at the end. Everything else in this file reports into one.
model Season {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /** "2026-27", as a club writes it. */
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    SeasonStatus @default(UPCOMING)
  /** The split between the two halves — pre-Christmas, then to May. */
  halfwayAt DateTime
  /** Set at the closing ceremony, never before. */
  championId String?
  champion   User?    @relation("SeasonChampion", fields: [championId], references: [id])
  closedAt   DateTime?

  tournaments  Tournament[]
  clubNights   ClubNight[]
  divisions    Division[]
  trophyAwards TrophyAward[]
  teamMatches  TeamMatch[]
  championship Championship?
  submissions  GradingSubmission[]

  @@index([clubId, status])
}

/// The play-off that decides the club champion: winner of the autumn
/// half against winner of the spring half, two games, colours reversed.
model Championship {
  id             String    @id @default(cuid())
  seasonId       String    @unique
  season         Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  autumnWinnerId String?
  springWinnerId String?
  game1Id        String?
  game2Id        String?
  /** The same player won both halves, so there is nothing to play off. */
  outright       Boolean   @default(false)
  championId     String?
  decidedAt      DateTime?
  /** Which rule settled it, recorded so it can be shown and argued with. */
  decidedBy      String?
}

/// A named division. Clubs name these after members who served them —
/// the Homan League, the Dunleavy League — not "Division 1".
model Division {
  id            String     @id @default(cuid())
  seasonId      String
  season        Season     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  half          SeasonHalf
  name          String
  /** Rank for promotion and relegation. 0 is the top division. */
  tier          Int
  promoteCount  Int        @default(2)
  relegateCount Int        @default(2)
  createdAt     DateTime   @default(now())

  members  DivisionMember[]
  fixtures LeagueFixture[]

  @@unique([seasonId, half, tier])
  @@index([seasonId, half])
}

model DivisionMember {
  id         String   @id @default(cuid())
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** Where they finished, written at the half. Null while playing. */
  finalRank  Int?
  promoted   Boolean  @default(false)
  relegated  Boolean  @default(false)

  @@unique([divisionId, userId])
  @@index([userId])
}

/// All-play-all. One fixture per pair, arranged by the players
/// themselves a week or so ahead — which is how club leagues actually
/// run, and why this must not go through the Swiss pairing engine.
model LeagueFixture {
  id         String       @id @default(cuid())
  divisionId String
  division   Division     @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  whiteId    String
  white      User         @relation("FixtureWhite", fields: [whiteId], references: [id])
  blackId    String
  black      User         @relation("FixtureBlack", fields: [blackId], references: [id])
  state      FixtureState @default(SCHEDULED)
  /** "1-0" | "0-1" | "1/2-1/2". Null until played. */
  result     String?
  liveGameId String?      @unique
  /** End of the half, or a date the organiser set. Drives the nudge. */
  dueBy      DateTime?
  arrangedAt DateTime?
  playedAt   DateTime?

  @@unique([divisionId, whiteId, blackId])
  @@index([divisionId, state])
  @@index([whiteId, state])
  @@index([blackId, state])
}

model LadderChallenge {
  id           String               @id @default(cuid())
  clubId       String
  club         Club                 @relation(fields: [clubId], references: [id], onDelete: Cascade)
  challengerId String
  challenger   User                 @relation("LadderChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  defenderId   String
  defender     User                 @relation("LadderDefender", fields: [defenderId], references: [id], onDelete: Cascade)
  state        LadderChallengeState @default(OPEN)
  /** Rungs apart when issued, kept so the rule can be audited later. */
  rungGap      Int
  liveGameId   String?
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  resolvedAt   DateTime?

  @@index([clubId, state])
  @@index([defenderId, state])
  @@index([challengerId, state])
}

/// A named trophy with decades of history behind it.
model Trophy {
  id          String   @id @default(cuid())
  clubId      String
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())

  awards TrophyAward[]

  @@unique([clubId, name])
}

model TrophyAward {
  id        String   @id @default(cuid())
  trophyId  String
  trophy    Trophy   @relation(fields: [trophyId], references: [id], onDelete: Cascade)
  /** Null on purpose: a club should be able to type in its roll of
   *  honour back to 1974, long before GLYPH existed. */
  seasonId  String?
  season    Season?  @relation(fields: [seasonId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** The season as written on the trophy itself: "1987-88". */
  year      String
  note      String?
  awardedAt DateTime @default(now())

  @@index([trophyId, year])
  @@index([userId])
}

model GradingSubmission {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId    String
  season      Season          @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  half        SeasonHalf
  state       SubmissionState @default(DRAFT)
  gameCount   Int             @default(0)
  submittedAt DateTime?
  /** Free text: which federation, and the reference they gave back. */
  reference   String?

  @@unique([seasonId, half])
}

enum SeasonStatus {
  UPCOMING
  ACTIVE
  COMPLETE
}

enum SeasonHalf {
  AUTUMN
  SPRING
}

enum FixtureState {
  /** Owed, not yet arranged. */
  SCHEDULED
  ARRANGED
  LIVE
  PLAYED
  /** One player did not turn up. */
  DEFAULTED
  VOID
}

enum LadderChallengeState {
  OPEN
  ACCEPTED
  DECLINED
  EXPIRED
  PLAYED
}

enum SubmissionState {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
}

// ---------------- TOURNAMENTS ----------------

model Tournament {
  id            String           @id @default(cuid())
  clubId        String
  club          Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  seasonId      String?
  season        Season?          @relation(fields: [seasonId], references: [id])
  name          String
  format        TournamentFormat @default(SWISS)
  timeControl   TimeControl      @default(RAPID)
  timeControlDetail String?
  status        TournamentStatus @default(DRAFT)
  totalRounds   Int              @default(5)
  currentRound  Int              @default(0)
  isRated       Boolean          @default(true)
  kFactorOverride Int?
  maxPlayers    Int?
  entryFeeCents Int?             @default(0)
  startsAt      DateTime?
  checkInOpensAt DateTime?
  location      String?
  description   String?          @db.Text
  tiebreakOrder String[]         @default(["BUCHHOLZ", "SONNEBORN_BERGER", "DIRECT_ENCOUNTER"])
  allowHalfByes Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  entries TournamentPlayer[]
  rounds  Round[]
  chatRoom ChatRoom?

  @@index([clubId, status])
}

model TournamentPlayer {
  id           String   @id @default(cuid())
  tournamentId String
  userId       String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seedRating   Int        @default(1200)
  score        Float      @default(0)
  checkedIn    Boolean    @default(false)
  withdrawn    Boolean    @default(false)
  withdrawnAtRound Int?
  requestedByes Int[]     @default([])
  colorHistory String     @default("")
  performanceRating Int?
  finalRank    Int?

  @@unique([tournamentId, userId])
  @@index([tournamentId, score])
}

model Round {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  number       Int
  startsAt     DateTime?
  completedAt  DateTime?
  matches      Match[]

  @@unique([tournamentId, number])
}

model Match {
  id           String       @id @default(cuid())
  roundId      String
  round        Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  boardNumber  Int
  whiteId      String?
  blackId      String?
  white        User?        @relation("WhitePlayer", fields: [whiteId], references: [id])
  black        User?        @relation("BlackPlayer", fields: [blackId], references: [id])
  result       MatchResult  @default(PENDING)
  resultStatus ResultStatus @default(PENDING)
  submittedById String?
  clientTimestamp DateTime?
  confirmedAt  DateTime?
  liveGameId   String?      @unique
  liveGame     LiveGame?    @relation(fields: [liveGameId], references: [id])
  game         Game?
  dispute      Dispute?

  @@index([roundId])
  @@index([whiteId])
  @@index([blackId])
}

// PGN archive of finished games

model Game {
  id        String   @id @default(cuid())
  matchId   String?  @unique
  match     Match?   @relation(fields: [matchId], references: [id])
  ownerId   String
  owner     User     @relation("GameOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pgn       String   @db.Text
  eco       String?
  moveCount Int?
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([eco])
}

model Dispute {
  id         String   @id @default(cuid())
  matchId    String   @unique
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  raisedById String
  raisedBy   User     @relation("DisputeRaiser", fields: [raisedById], references: [id])
  reason     String   @db.Text
  ruling     String?  @db.Text
  arbiterId  String?
  arbiter    User?    @relation("DisputeArbiter", fields: [arbiterId], references: [id])
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
}

// ---------------- LIVE PLAY (human vs human) ----------------

/** A challenge from one player to another. Accepting creates a LiveGame. */
model Challenge {
  id          String   @id @default(cuid())
  fromId      String
  from        User     @relation("ChallengesSent", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String?  // null = an open seek any club member may accept
  to          User?    @relation("ChallengesReceived", fields: [toId], references: [id], onDelete: Cascade)
  clubId      String?
  expiresAt   DateTime?
  timeControl String   @default("900+10")
  color       String   @default("random")
  rated       Boolean  @default(true)
  status      String   @default("pending")
  liveGameId  String?
  message     String?
  createdAt   DateTime @default(now())

  @@index([toId, status])
}

/** A game two humans are actually playing. The server owns the position. */
model LiveGame {
  id          String         @id @default(cuid())
  whiteId     String
  white       User           @relation("LiveGamesWhite", fields: [whiteId], references: [id], onDelete: Cascade)
  blackId     String
  black       User           @relation("LiveGamesBlack", fields: [blackId], references: [id], onDelete: Cascade)
  fen         String         @default("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
  sans        String[]       @default([])
  status      LiveGameStatus @default(ACTIVE)
  result      String?
  endReason   String?
  timeControl String         @default("900+10")
  rated       Boolean        @default(true)
  whiteMs     Int            @default(900000)
  blackMs     Int            @default(900000)
  incrementMs Int            @default(10000)
  lastMoveAt  DateTime       @default(now())
  drawOfferBy String?
  category    SpeedCategory  @default(RAPID)
  clockStarted Boolean       @default(false)
  whiteRatingBefore Int?
  blackRatingBefore Int?
  whiteRatingDelta  Int?
  blackRatingDelta  Int?
  /** When each player was last seen at this board — see the claim route. */
  whiteSeenAt  DateTime?
  blackSeenAt  DateTime?
  undoFen      String?
  undoWhiteMs  Int?
  undoBlackMs  Int?
  takebackBy   String?
  disconnectAt DateTime?
  messages    GameMessage[]
  spectators  Spectator[]
  railReacts  RailReaction[]
  whispers    Whisper[]
  match       Match?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([whiteId])
  @@index([blackId])
  @@index([status])
}

// ---------------- MESSAGING ----------------

model ChatRoom {
  id           String   @id @default(cuid())
  clubId       String?
  club         Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tournamentId String?  @unique
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  name         String?
  isDirect     Boolean  @default(false)
  isRequest    Boolean  @default(false)
  acceptedAt   DateTime?
  isAnnouncement Boolean @default(false)
  category     String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())

  members  ChatRoomMember[]
  messages Message[]

  @@index([clubId])
}

model ChatRoomMember {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  room       ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())
  muted      Boolean  @default(false)

  @@unique([roomId, userId])
}

model Message {
  id        String   @id @default(cuid())
  roomId    String
  senderId  String
  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String   @db.Text
  fileUrl   String?
  fileType  String?
  replyToId String?
  reactions Reaction[]
  createdAt DateTime @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([roomId, createdAt])
}

// ---------------- FEED ----------------

model Post {
  id        String   @id @default(cuid())
  clubId    String?
  authorId  String
  club      Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type      PostType @default(TEXT)
  body      String?  @db.Text

  mediaUrls   String[] @default([])
  videoUrl    String?
  durationSec Int?
  isStudio    Boolean  @default(false)

  pgn            String? @db.Text
  criticalPly    Int?

  puzzleFen      String?
  puzzleSolution String?
  /** Who answered a POSITION post correctly. */
  puzzleSolvedBy String[] @default([])
  /** A GAME or WELCOME post points back at what it is about. */
  liveGameId     String?
  subjectUserId  String?
  solveCount     Int      @default(0)
  attemptCount   Int      @default(0)

  pinned     Boolean  @default(false)
  pinnedAt   DateTime?
  archived   Boolean  @default(false)
  archivedAt DateTime?
  visibility PostVisibility @default(PUBLIC)
  editedAt   DateTime?
  viewCount  Int      @default(0)
  shareCount Int      @default(0)
  saveCount  Int      @default(0)
  repostCount Int     @default(0)
  repostOfId String?
  repostOf   Post?    @relation("Reposts", fields: [repostOfId], references: [id])
  reposts    Post[]   @relation("Reposts")
  hdOriginalUrl String?
  comments  Comment[]
  reactions Reaction[]
  bookmarks Bookmark[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clubId, pinned, createdAt])
  @@index([authorId, createdAt])
  @@index([type, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String?  @db.Text
  videoUrl  String?
  parentId  String?
  parent    Comment? @relation("Thread", fields: [parentId], references: [id])
  replies   Comment[] @relation("Thread")
  reactions Reaction[]
  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([parentId])
}

model Reaction {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         ReactionKind @default(PAWN)
  reactorElo   Int?
  postId       String?
  commentId    String?
  messageId    String?
  post         Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([userId, kind, postId, commentId, messageId])
  @@index([postId, kind])
}

// ---------------- EVENTS ----------------

model Event {
  id          String    @id @default(cuid())
  clubId      String
  club        Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  type        EventType @default(MEETING)
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  capacity    Int?
  reminderSent Boolean  @default(false)
  rsvps       Rsvp[]
  createdAt   DateTime  @default(now())

  @@index([clubId, startsAt])
}

model Rsvp {
  id       String     @id @default(cuid())
  eventId  String
  userId   String
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status   RsvpStatus @default(GOING)
  attended Boolean?

  @@unique([eventId, userId])
}

// ---------------- ACHIEVEMENTS ----------------

model Achievement {
  id          String  @id @default(cuid())
  clubId      String?
  club        Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  code        String
  name        String
  description String
  iconUrl     String?
  awards      UserAchievement[]

  @@unique([clubId, code])
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  tournamentId  String?
  awardedAt     DateTime    @default(now())

  @@index([userId])
}

// ---------------- NOTIFICATIONS ----------------

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?
  readAt    DateTime?
  emailSent Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// ---------------- BILLING ----------------

model Subscription {
  id                   String             @id @default(cuid())
  clubId               String             @unique
  club                 Club               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  tier                 SubscriptionTier   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Payment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  stripeInvoiceId String?      @unique
  amountCents     Int
  currency        String       @default("usd")
  paidAt          DateTime?
  invoiceUrl      String?
  createdAt       DateTime     @default(now())
}

// ---------------- SOCIAL EXTRAS ----------------

model ClubJoinRequest {
  id        String            @id @default(cuid())
  clubId    String
  userId    String
  club      Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  decidedBy String?
  createdAt DateTime          @default(now())

  @@unique([clubId, userId])
  @@index([clubId, status])
}

model BookmarkFolder {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())

  @@unique([userId, name])
}

model Bookmark {
  id        String          @id @default(cuid())
  userId    String
  postId    String
  folderId  String?
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  folder    BookmarkFolder? @relation(fields: [folderId], references: [id])
  createdAt DateTime        @default(now())

  @@unique([userId, postId])
}

model Streak {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  current      Int       @default(0)
  best         Int       @default(0)
  freezes      Int       @default(1)
  lastActiveAt DateTime?
}

// ---------------- AUDIT ----------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  clubId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}
// ---------------- GLYPH RATINGS & GAME CHAT ----------------

enum SpeedCategory {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

enum GameMessageKind {
  CHAT
  QUICK
  SYSTEM
}

/**
 * Platform-wide rating, one row per speed. Glicko-1: the number is only
 * half the story, `rd` is how sure we are of it. Provisional while
 * rd > 110, which is how a new player stops swinging after ~15 games.
 */
model GlyphRating {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation("GlyphRatings", fields: [userId], references: [id], onDelete: Cascade)
  category     SpeedCategory
  rating       Float         @default(1200)
  rd           Float         @default(350)
  games        Int           @default(0)
  peak         Int           @default(1200)
  volatility   Float         @default(0.06)
  wins         Int           @default(0)
  losses       Int           @default(0)
  draws        Int           @default(0)
  peakAt       DateTime?
  lastPlayedAt DateTime?
  history      GlyphRatingHistory[]

  @@unique([userId, category])
  @@index([category, rating])
}

model GameMessage {
  id        String          @id @default(cuid())
  gameId    String
  game      LiveGame        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation("GameMessages", fields: [userId], references: [id], onDelete: Cascade)
  body      String
  kind      GameMessageKind @default(CHAT)
  createdAt DateTime        @default(now())

  @@index([gameId, createdAt])
}

/**
 * One row per rated game, per player. This is what a profile graph is
 * drawn from, and what makes a rating auditable rather than a number
 * that simply changed overnight.
 */
model GlyphRatingHistory {
  id             String      @id @default(cuid())
  glyphRatingId  String
  glyphRating    GlyphRating @relation(fields: [glyphRatingId], references: [id], onDelete: Cascade)
  liveGameId     String?
  before         Int
  after          Int
  delta          Int
  opponentRating Int
  result         String      // win | loss | draw
  createdAt      DateTime    @default(now())

  @@index([glyphRatingId, createdAt])
}


// ============================================================
// THE RAIL — the people standing around the board.
//
// In a club the game is never private: members drift over, watch,
// wince and argue about the position. These three tables are that,
// made real, with one hard constraint running through all of them —
// a spectator must never be able to help a player.
// ============================================================

model Spectator {
  id         String   @id @default(cuid())
  liveGameId String
  liveGame   LiveGame @relation(fields: [liveGameId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** "w", "b" or null — who they are backing, which is pure tribalism. */
  backing    String?
  joinedAt   DateTime @default(now())
  /** Watching is a heartbeat, not a session: stale rows simply age out. */
  lastSeenAt DateTime @default(now())

  @@unique([liveGameId, userId])
  @@index([liveGameId, lastSeenAt])
}

enum RailReactionKind {
  BRILLIANT
  BLUNDER
  NICE
  RESPECT
}

model RailReaction {
  id         String           @id @default(cuid())
  liveGameId String
  liveGame   LiveGame         @relation(fields: [liveGameId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       RailReactionKind
  /** The half-move it was aimed at, so a recap can line them up. */
  ply        Int              @default(0)
  createdAt  DateTime         @default(now())
  /**
   * When players may see it. Written a few seconds into the future on
   * purpose: an instant "blunder!" from the rail is a hint, and a hint
   * is cheating. The delay keeps the warmth and removes the signal.
   */
  showAt     DateTime

  @@index([liveGameId, showAt])
}

model Whisper {
  id         String   @id @default(cuid())
  liveGameId String
  liveGame   LiveGame @relation(fields: [liveGameId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  createdAt  DateTime @default(now())

  @@index([liveGameId, createdAt])
}


// ============================================================
// CLUB NIGHT — the weekly rhythm a real club runs on.
// Recurring by definition: a one-off event that has to be recreated
// every week is the thing clubs stop doing.
// ============================================================

enum ClubNightState {
  SCHEDULED
  LIVE
  FINISHED
  CANCELLED
}

enum RsvpState {
  GOING
  MAYBE
  OUT
}

model ClubNight {
  id          String         @id @default(cuid())
  clubId      String
  club        Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /** 0 = Sunday. With startsAt this defines the recurrence. */
  dayOfWeek   Int
  /** The next occurrence. Rolled forward a week once it finishes. */
  startsAt    DateTime
  timeControl String         @default("600+5")
  rounds      Int            @default(3)
  state       ClubNightState @default(SCHEDULED)
  active      Boolean        @default(true)
  /**
   * The tournament this occurrence is running as.
   *
   * A club night IS a small Swiss, so it runs as one rather than
   * growing a second pairing implementation beside the tested one.
   * Cleared when the occurrence rolls forward to next week.
   */
  tournamentId String?
  /** Which season this night counts toward. */
  seasonId    String?
  season      Season?        @relation(fields: [seasonId], references: [id])
  createdAt   DateTime       @default(now())

  rsvps ClubNightRsvp[]

  @@index([clubId, startsAt])
}

model ClubNightRsvp {
  id          String    @id @default(cuid())
  clubNightId String
  clubNight   ClubNight @relation(fields: [clubNightId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state       RsvpState @default(GOING)
  /** Present when it actually started — RSVP is intent, this is attendance. */
  checkedInAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([clubNightId, userId])
  @@index([clubNightId, state])
}

// ============================================================
// THE LADDER — beat someone above you and take their rung.
// A century-old club tradition that exists in no app.
// ============================================================

model LadderRung {
  id       String   @id @default(cuid())
  clubId   String
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position Int
  movedAt  DateTime @default(now())

  @@unique([clubId, userId])
  /** Two members cannot occupy the same rung. */
  @@unique([clubId, position])
}

// ============================================================
// CLUB vs CLUB — a team match across several boards.
// ============================================================

enum TeamMatchState {
  PROPOSED
  ACCEPTED
  LIVE
  FINISHED
  CANCELLED
}

model TeamMatch {
  id         String         @id @default(cuid())
  homeClubId String
  homeClub   Club           @relation("TeamMatchHome", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClubId String
  awayClub   Club           @relation("TeamMatchAway", fields: [awayClubId], references: [id], onDelete: Cascade)
  startsAt   DateTime
  state      TeamMatchState @default(PROPOSED)
  homeScore  Float          @default(0)
  awayScore  Float          @default(0)
  seasonId   String?
  season     Season?        @relation(fields: [seasonId], references: [id])
  /** Board 1 must be the strongest. Checked on submit, recorded here. */
  boardOrderLocked Boolean  @default(false)
  createdAt  DateTime       @default(now())

  boards TeamBoard[]

  @@index([homeClubId, state])
  @@index([awayClubId, state])
}

model TeamBoard {
  id          String    @id @default(cuid())
  teamMatchId String
  teamMatch   TeamMatch @relation(fields: [teamMatchId], references: [id], onDelete: Cascade)
  boardNumber Int
  homeUserId  String
  awayUserId  String
  liveGameId  String?
  /** "1-0" | "0-1" | "1/2-1/2" */
  result      String?
  /** Which club each player turned out for. Members may hold several,
   *  and should not have to leave one to play for another. */
  homeRepresentingClubId String?
  awayRepresentingClubId String?

  @@unique([teamMatchId, boardNumber])
}

// ============================================================
// MODERATION — a community product without these is negligent.
// ============================================================

enum ReportState {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

model Report {
  id         String      @id @default(cuid())
  reporterId String
  reporter   User        @relation("ReportsRaised", fields: [reporterId], references: [id], onDelete: Cascade)
  /** "post" | "message" | "user" | "game" — kept loose so a new surface
      does not need a migration to become reportable. */
  targetType String
  targetId   String
  reason     String
  detail     String?
  state      ReportState @default(OPEN)
  createdAt  DateTime    @default(now())

  @@index([state, createdAt])
  @@index([targetType, targetId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksAgainst", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}
