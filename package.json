{
  "name": "glyph",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "prisma generate && prisma db push --accept-data-loss && next build",
    "build:local": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "socket": "node --experimental-strip-types src/lib/realtime/socket-server.ts",
    "test:engine": "node --experimental-strip-types lib/test-tournament.ts",
    "test:rating": "node --experimental-strip-types lib/test-rating.ts",
    "test:board": "node --experimental-strip-types lib/test-board.ts",
    "test:replay": "node --experimental-strip-types lib/test-replay.ts",
    "test:api-shape": "node --experimental-strip-types lib/test-api-shape.ts",
    "test:time": "node --experimental-strip-types lib/test-time.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.4.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.25",
    "pdfkit": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "stripe": "^17.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.0",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
